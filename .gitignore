# CloudSnap — .gitignore

# ─── Node / npm ────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Build outputs ──────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
coverage/
*.tsbuildinfo

# ─── Environment files (NEVER COMMIT REAL SECRETS) ──────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
backend/.env

# ─── AWS Credentials & Config ───────────────────────────
.aws/
samconfig.toml
# NOTE: samconfig.toml.example is intentionally tracked

# ─── IDE & Editor ───────────────────────────────────────
.idea/
.vscode/settings.json
.vscode/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ─── Lambda packaging ───────────────────────────────────
.aws-sam/
backend/.aws-sam/
*.zip
*.tar.gz

# ─── Logs ───────────────────────────────────────────────
logs/
*.log
*.log.*

# ─── Test artifacts ─────────────────────────────────────
.nyc_output/
coverage/
test-results/

# ─── Temporary files ────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
