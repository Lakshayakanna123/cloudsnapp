# Frontend Environment Variables — CloudSnap
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER put AWS secret keys in frontend env files.
#
# These are all exposed to browser code (VITE_ prefix).

# ─── Amazon Cognito ─────────────────────────────────────
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=us-east-1

# ─── API Gateway ────────────────────────────────────────
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# ─── CloudFront CDN ─────────────────────────────────────
VITE_CLOUDFRONT_DOMAIN=xxxxxxxxxxxx.cloudfront.net
